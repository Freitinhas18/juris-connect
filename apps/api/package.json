{
  "name": "@juris-connect/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:safe": "powershell -NoProfile -ExecutionPolicy Bypass -File ./test/run-safe.ps1",
    "test:browser:safe": "powershell -NoProfile -ExecutionPolicy Bypass -File ./test/run-browser-safe.ps1",
    "demo:seed:test": "powershell -NoProfile -ExecutionPolicy Bypass -File ./test/seed-demo-test.ps1",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.8",
    "@juris-connect/shared": "workspace:*",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15"
  }
}
